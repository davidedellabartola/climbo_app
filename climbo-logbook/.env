# Copia questo file in .env e cambia la password (usa solo lettere e numeri)
POSTGRES_USER=climbo
POSTGRES_PASSWORD=CLIMB
POSTGRES_DB=climbo_logbook
APP_PORT=3000
MAX_UPLOAD_MB=10

# Login: se false, nessuno può creare nuovi account (utile dopo aver creato i tuoi)
ALLOW_REGISTRATION=true
# Metti true solo se l'app è servita via HTTPS (es. dietro un reverse proxy)
COOKIE_SECURE=false

# Email dell'account amministratore (può caricare foto pareti, eliminare vie, gestire contest)
ADMIN_EMAIL=climbotest@gmail.com